# Copie para .env (que NAO vai para o repositorio) e preencha localmente.
# Em producao, estes valores vivem em Environment Variables do projeto Vercel
# do sistema interno — nunca no projeto do site institucional.

# Postgres gerenciado (Neon, regiao sa-east-1 / Sao Paulo).
DATABASE_URL="postgresql://usuario:senha@host/hrs_interno?sslmode=require"

# Chave mestra AES-256-GCM (32 bytes em base64) para criptografia de coluna:
# dados sensiveis de saude e segredo TOTP. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTOGRAFIA_V1=""
CHAVE_CRIPTOGRAFIA_VERSAO_ATUAL="1"

# Segredo de assinatura da sessao (Auth.js). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Base absoluta do sistema interno, usada para montar o link do portal entregue
# ao cliente. Precisa ser um SUBDOMINIO proprio: o apex hrsadvocacia.adv.br
# serve o site institucional, e dois projetos Vercel nao compartilham hostname.
NEXT_PUBLIC_URL_BASE="https://interno.hrsadvocacia.adv.br"

# Desliga a telemetria do Next: sistema com dado sob sigilo nao envia
# estatistica de uso para terceiro.
NEXT_TELEMETRY_DISABLED="1"

# Autentica o job diario de alertas de prazo (/api/cron/alertas). A Vercel envia
# este valor no cabecalho Authorization. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
