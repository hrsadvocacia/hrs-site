  "private": true,
  "description": "Sistema interno de gestao do HRS Advocacia. Projeto Vercel separado do site institucional: variaveis de ambiente, protecao por IP/WAF, cadencia de deploy e logs isolados.",
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
