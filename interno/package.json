    "test:invariantes": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/testes/invariantes.sql",
    "migrate:deploy": "prisma migrate deploy",
    "test": "node --test --experimental-strip-types \"lib/*.test.ts\""
  },
  "devDependencies": {
